{
  "name": "@goweskit/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint app nuxt.config.ts vitest.config.ts",
    "postinstall": "nuxt prepare",
    "predev": "pnpm --filter @goweskit/bike-domain build && pnpm --filter @goweskit/contracts build && pnpm --filter @goweskit/ui build",
    "pretest": "pnpm --filter @goweskit/bike-domain build && pnpm --filter @goweskit/contracts build && pnpm --filter @goweskit/ui build",
    "preview": "nuxt preview",
    "test": "vitest run",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@goweskit/bike-domain": "workspace:*",
    "@goweskit/contracts": "workspace:*",
    "@goweskit/ui": "workspace:*",
    "maplibre-gl": "6.2.0",
    "nuxt": "4.5.2",
    "qrcode": "^1.5.4",
    "sweetalert2": "^11.26.25",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/nuxt": "^1.1.1"
  }
}
